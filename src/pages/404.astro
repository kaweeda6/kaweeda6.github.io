---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CallBar from "../components/CallBar.astro";
import { BOOK_APPOINTMENT_URL } from "../data/site";
---
<Base title="Page not found | Thrive Dental" description="We couldn’t find that page." noIndex={true}>
  <Fragment slot="header"><Header /></Fragment>
  <div class="bg-sand-50">
    <div class="container-slim py-24 text-center lg:py-32">
      <p class="eyebrow text-brand-500">404 — Page not found</p>
      <h1 class="display-1 mt-4">We couldn’t find that page.</h1>
      <p class="mx-auto mt-5 max-w-md text-slate-600">The page may have moved or no longer exists — but we’re still right here on Bell Blvd.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn-primary">Go Home</a>
        <a href={BOOK_APPOINTMENT_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">Book Appointment</a>
        <a href="tel:+1-718-225-6677" class="btn-secondary">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.09 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.81.3 1.6.57 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.73-1.73a2 2 0 0 1 2.11-.45c.75.27 1.54.45 2.35.57A2 2 0 0 1 22 16.92z"/></svg>
          (718) 225-6677
        </a>
      </div>
    </div>
  </div>
  <Fragment slot="footer"><Footer /></Fragment>
  <CallBar />
</Base>
